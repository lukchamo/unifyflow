# ── UnifyFlow environment ─────────────────────────────────────────────────────
# Copy to `.env.local` for local dev. The npm scripts (`dev:emulator`) set the
# emulator flag for you, so for the default emulator workflow you don't even
# need a .env.local — these values are the safe demo defaults.

# Which data layer the app uses:
#   mock     → in-memory + localStorage (the original demo, works on Vercel)
#   firebase → Firestore + Firebase Auth (real lifecycle, emulator or cloud)
NEXT_PUBLIC_DATA_BACKEND=firebase

# Point the Firebase SDKs at the local emulators (true for local dev).
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Firebase web config. For the EMULATOR these can be any non-empty demo values
# as long as the project id starts with `demo-`. For a REAL project, paste the
# config from Firebase Console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-unifyflow.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-unifyflow
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-unifyflow.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demouni0000000000

# Emulator host/ports (only read when NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true).
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# ── Server-only (Admin SDK, used by the seed script & any server actions) ─────
# When talking to the emulator the seed script auto-sets FIRESTORE_EMULATOR_HOST
# and FIREBASE_AUTH_EMULATOR_HOST, so no service-account key is needed.
# For a REAL project, set GOOGLE_APPLICATION_CREDENTIALS to a service-account
# JSON path, or paste the key inline below.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Default password for the seeded demo users (email sign-in).
SEED_DEFAULT_PASSWORD=unifyflow123
